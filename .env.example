NODE_ENV=development
PORT=3000
# Canonical website origin and password-reset destination. In production use HTTPS.
# FRONTEND_URL remains a temporary compatibility fallback for older deployments.
PUBLIC_WEB_URL=http://localhost:3000
FRONTEND_URL=
# Comma-separated browser origins allowed to call the API with CORS credentials.
# Native mobile apps and server-to-server workers normally send no Origin header
# and are not governed by browser CORS. If unset, PUBLIC_WEB_URL is used.
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=

# Reverse-proxy hop count used by Express when deriving req.ip for rate limiting.
# Development defaults to direct client IP. Production defaults to one trusted
# proxy hop for backward compatibility. Set 0/off for direct exposure or an
# explicit integer from 1-5 for the actual deployment topology. Do not use a
# trust-all boolean.
TRUST_PROXY=

# Optional one-time first-admin bootstrap for a fresh production PostgreSQL DB.
# If an admin already exists these values are ignored. Use a strong password,
# log in, then remove ADMIN_PASSWORD from the deployment environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public account registration is disabled by default. The current product uses
# a private admin login surface; only set true if public registration is intended.
ALLOW_PUBLIC_REGISTRATION=false

# Legacy synthetic demo users/deals are disabled by default. This flag is
# development-only and is ignored in production.
ALLOW_DEMO_SEED=false

# PostgreSQL. For Cloud Run + Cloud SQL, prefer the native Unix socket settings
# below. DATABASE_URL remains supported for other PostgreSQL deployments.
CLOUD_SQL_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=
# DATABASE_URL TLS mode: verify-full (default, certificate verified), require
# (encrypted but certificate not verified), or disable. Cloud SQL Unix sockets
# do not use nested TLS here because the platform secures the socket transport.
PGSSL=verify-full
PG_POOL_MAX=5

AMAZON_ASSOCIATE_TAG=
RAINFOREST_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# SMTP email delivery for verification codes and password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Amazon Product Advertising API (PA-API v5). Optional when Rainforest is used.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_REGION=us-east-1
AMAZON_PAAPI_HOST=webservices.amazon.com

# Active deal-data provider: auto | amazon_paapi | rainforest
DEAL_DATA_PROVIDER=auto
# Hard guard against accidental Rainforest overage. Defaults match the current
# 500-request/month operating target and can be raised when the provider plan changes.
RAINFOREST_DAILY_REQUEST_LIMIT=16
RAINFOREST_MONTHLY_REQUEST_LIMIT=500

# Optional QA sampling of otherwise auto-approvable deals. The default is zero:
# normal verified deals publish automatically and only real exceptions require review.
EDITORIAL_HOLDBACK_PERCENT=0

# Standalone publication worker. Run with `npm run publisher` using the same
# production image/database as the web API. DealScout owns candidate selection,
# revalidation, factual content, cadence, idempotency and retry; the selected
# transport only delivers already-prepared content.
PUBLICATION_CHANNEL=whatsapp_status
# webhook | waha
PUBLICATION_TRANSPORT=webhook
# continuous polls until SIGTERM; once performs one bounded queue/drain cycle.
PUBLICATION_RUN_MODE=continuous

# Generic webhook transport.
PUBLICATION_WEBHOOK_URL=
# Required for webhook transport in production; use Secret Manager or equivalent.
PUBLICATION_WEBHOOK_TOKEN=
PUBLICATION_WEBHOOK_TIMEOUT_MS=15000

# WAHA transport for PUBLICATION_CHANNEL=whatsapp_status only.
# In production expose WAHA through a private/network-restricted HTTPS endpoint.
WAHA_BASE_URL=
# Sent as X-Api-Key. Required and 16+ chars in production.
WAHA_API_KEY=
# Explicit paired WAHA session name, for example dealscout-status.
WAHA_SESSION=
# Bound image-Status transport calls so a stalled WhatsApp media upload retries
# through DealScout's durable publication queue instead of hanging the worker.
WAHA_TIMEOUT_MS=20000

# WhatsApp Status defaults are deliberately slow and one-at-a-time. The runtime
# checks durable publication history and a PostgreSQL advisory lock, so restarting
# or scaling workers does not reset cadence or allow parallel Status posts.
PUBLICATION_POLL_MS=1800000
PUBLICATION_MIN_SPACING_SECONDS=1800
PUBLICATION_QUEUE_BATCH=2
PUBLICATION_CANDIDATE_LIMIT=100
PUBLICATION_MAX_PER_CYCLE=1