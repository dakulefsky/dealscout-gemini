NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=

# PostgreSQL. Price history uses Postgres when DATABASE_URL is configured;
# local development falls back to server/data/price-history.json.
DATABASE_URL=
PGSSL=require
PG_POOL_MAX=5

AMAZON_ASSOCIATE_TAG=
RAINFOREST_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# SMTP email delivery for verification codes and password resets
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Amazon Product Advertising API (PA-API v5)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_REGION=us-east-1
AMAZON_PAAPI_HOST=webservices.amazon.com

# Active deals data provider: auto | amazon_paapi | rainforest | curated
# "curated" is demo/development data and is never source-verified.
DEAL_DATA_PROVIDER=auto

# Percentage of otherwise auto-approvable verified deals intentionally held
# for recurring human editorial review. 0 disables; 100 requires human review
# for every strong deal. This is a DealScout operational policy, not an Amazon
# published requirement or safe-harbor percentage.
EDITORIAL_HOLDBACK_PERCENT=20
