NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=

# Optional one-time first-admin bootstrap for a fresh production PostgreSQL DB.
# If an admin already exists these values are ignored. Use a strong password,
# log in, then remove ADMIN_PASSWORD from the deployment environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public account registration is disabled by default. The current product uses
# a private admin login surface; only set true if public registration is intended.
ALLOW_PUBLIC_REGISTRATION=false

# Legacy synthetic demo users/deals are disabled by default. This flag is
# development-only and is ignored in production.
ALLOW_DEMO_SEED=false

# PostgreSQL. For Cloud Run + Cloud SQL, prefer the native Unix socket settings
# below. DATABASE_URL remains supported for other PostgreSQL deployments.
CLOUD_SQL_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=
# DATABASE_URL TLS mode: verify-full (default, certificate verified), require
# (encrypted but certificate not verified), or disable. Cloud SQL Unix sockets
# do not use nested TLS here because the platform secures the socket transport.
PGSSL=verify-full
PG_POOL_MAX=5

AMAZON_ASSOCIATE_TAG=
RAINFOREST_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# SMTP email delivery for verification codes and password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Amazon Product Advertising API (PA-API v5). Optional when Rainforest is used.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_REGION=us-east-1
AMAZON_PAAPI_HOST=webservices.amazon.com

# Active deal-data provider: auto | amazon_paapi | rainforest
DEAL_DATA_PROVIDER=auto

# Percentage of otherwise auto-approvable verified deals intentionally held
# for recurring editorial review. 0 disables; 100 requires review for every
# otherwise strong deal. This is a DealScout operational policy, not an Amazon
# published requirement or safe-harbor percentage.
EDITORIAL_HOLDBACK_PERCENT=20